# ---------------------------------------------------------------------------
# The line: its size, its CR, its body
# ---------------------------------------------------------------------------

def be_lo.c(+s: U32, +lf: U32, +hsl: {Nat.is_lt(n(s), n(lf)) == True{} : Bool}, +c: Bool) ->
  {Nat.is_le(n(s), n(Bool.pick(U32, c, LI.U1(lf), lf))) == True{} : Bool}:
  match c:
    case True{}:
      LI.s_le_u(s, lf, LI.lf_u(lf, LI.one_le(s, lf, hsl)), hsl)
    case False{}:
      N.lt_to_le(n(s), n(lf), hsl)

def be_hi.c(+s: U32, +lf: U32, +hsl: {Nat.is_lt(n(s), n(lf)) == True{} : Bool}, +c: Bool) ->
  {Nat.is_le(n(Bool.pick(U32, c, LI.U1(lf), lf)), n(lf)) == True{} : Bool}:
  match c:
    case True{}:
      N.lt_to_le(n(LI.U1(lf)), n(lf), LI.u_lt(lf, LI.lf_u(lf, LI.one_le(s, lf, hsl))))
    case False{}:
      N.le_refl(n(lf))

def be_lo.k(+len: U32, +t: AT.Tree<U32>, +s: U32, +lf: U32, +hsl: {Nat.is_le(n(s), n(lf)) == True{} : Bool}, +c: Bool, +e: {U32.is_lt(s, lf) == c : Bool}) ->
  {Nat.is_le(n(s), n(LI.BEk(c, LI.XC(len, t, c, lf), lf))) == True{} : Bool}:
  match c:
    case True{}:
      be_lo.c(s, lf, Equal.trans(Bool, Nat.is_lt(n(s), n(lf)), U32.is_lt(s, lf), True{}, Equal.sym(Bool, U32.is_lt(s, lf), Nat.is_lt(n(s), n(lf)), U.is_lt_to_nat(s, lf)), e),
        U32.is_eq(C.AT(len, t, LI.U1(lf)), 13))
    case False{}:
      hsl

def be_hi.k(+len: U32, +t: AT.Tree<U32>, +s: U32, +lf: U32, +c: Bool, +e: {U32.is_lt(s, lf) == c : Bool}) ->
  {Nat.is_le(n(LI.BEk(c, LI.XC(len, t, c, lf), lf)), n(lf)) == True{} : Bool}:
  match c:
    case True{}:
      be_hi.c(s, lf, Equal.trans(Bool, Nat.is_lt(n(s), n(lf)), U32.is_lt(s, lf), True{}, Equal.sym(Bool, U32.is_lt(s, lf), Nat.is_lt(n(s), n(lf)), U.is_lt_to_nat(s, lf)), e),
        U32.is_eq(C.AT(len, t, LI.U1(lf)), 13))
    case False{}:
      N.le_refl(n(lf))

def CR(+len: U32, +t: AT.Tree<U32>, +s: U32, +lf: U32) -> Bool:
  U32.is_lt(s, lf) && U32.is_eq(LI.XC(len, t, U32.is_lt(s, lf), lf), 13)

def TE(+len: U32, +t: AT.Tree<U32>, +s: U32, +lf: U32) -> NS.Rg:
  NS.Rg{LI.BE(len, t, s, lf), (lf + 1 : U32)}

# The body (s .. BE-1) cut at tabs, then the driver.
def body_t(+len: U32, +t: AT.Tree<U32>, +d: Nat, +hl: {D.ok(C.BT(len, t), d) == True{} : Bool}, +bw: BW, +defs: B.Defs, +os: Bool, +ow: Nat, +o0: Bool, +oa: Ss(),
  +s: U32, +lf: U32, +hsl: {Nat.is_le(n(s), n(lf)) == True{} : Bool}, +hlf: {Nat.is_lt(n(lf), n(len)) == True{} : Bool}) ->
  SPR(len, t, NS.go.body(CR(len, t, s, lf), C.BT(len, t), s, lf, o0, defs), SPEC(len, t, defs, os, ow, o0, oa, s, LI.BE(len, t, s, lf)), WT.TX(len, t, TE(len, t, s, lf))):
  +be = LI.BE(len, t, s, lf)
  +lo = be_lo.k(len, t, s, lf, hsl, U32.is_lt(s, lf), {==})
  +hi = be_hi.k(len, t, s, lf, U32.is_lt(s, lf), {==})
  +hbl = N.le_lt_trans(n(be), n(lf), n(len), hi, hlf)
  +hsle = Equal.trans(Bool, U32.is_le(s, be), Nat.is_le(n(s), n(be)), True{}, U.is_le_to_nat(s, be), lo)
  +hs = W.pv_mk(len, s, s, N.le_refl(n(s)), N.le_trans(n(s), n(lf), n(len), hsl, N.lt_to_le(n(lf), n(len), hlf)))
  +e1 = W.inc_n(len, t, d, lf, hl, LI.ult(lf, len, hlf))
  +hl1 = {%Equal.sym(Nat, n((lf + 1 : U32)), Nat.add(n(lf), 1n), e1) : {Nat.is_le(_, n(len)) == True{} : Bool};
    %Equal.sym(Nat, Nat.add(n(lf), 1n), 1n+n(lf), N.add_one(n(lf))) : {Nat.is_le(_, n(len)) == True{} : Bool};
    Equal.trans(Bool, Nat.is_le(1n+n(lf), n(len)), Nat.is_lt(n(lf), n(len)), True{}, N.le_succ_lt(n(lf), n(len)), hlf) : {Nat.is_le(n((lf + 1 : U32)), n(len)) == True{} : Bool}}
  +hl2 = {%Equal.sym(Nat, n((lf + 1 : U32)), Nat.add(n(lf), 1n), e1) : {Nat.is_le(n(lf), _) == True{} : Bool};
    N.le_add_r(n(lf), 1n) : {Nat.is_le(n(lf), n((lf + 1 : U32))) == True{} : Bool}}
  +hpt = W.pv_mk(len, be, (lf + 1 : U32), N.le_trans(n(be), n(lf), n((lf + 1 : U32)), hi, hl2), hl1)
  +FS = K.CUT(len, t, s, be, 9)
  %cut_s(len, t, d, hl, s, be, 9, hsle, N.lt_to_le(n(be), n(len), hbl), {==}) :
    SPR(len, t, NS.go.fields(_, s, o0, TE(len, t, s, lf), defs), SPEC(len, t, defs, os, ow, o0, oa, s, be), WT.TX(len, t, TE(len, t, s, lf)))
  gf(len, t, d, hl, bw, defs, os, ow, o0, oa, s, hs, be, hbl, TE(len, t, s, lf), hpt, FS, K.cut_pvz(len, t, d, s, be, 9, hl, hsle, hbl, {==}),
    Equal.sym(Ss(), K.TXS(len, t, FS), String.split(WT.TX(len, t, NS.Rg{s, be}), Chr{9}), K.cut_tx(len, t, d, s, be, 9, hl, hsle, hbl, {==})))

def sz.k(+len: U32, +t: AT.Tree<U32>, +d: Nat, +hl: {D.ok(C.BT(len, t), d) == True{} : Bool}, +bw: BW, +defs: B.Defs, +os: Bool, +ow: Nat, +o0: Bool, +oa: Ss(),
  +s: U32, +lf: U32, +hsl: {Nat.is_le(n(s), n(lf)) == True{} : Bool}, +hlf: {Nat.is_lt(n(lf), n(len)) == True{} : Bool}, +c: Bool) ->
  SPR(len, t, NS.go.size(c, C.BT(len, t), s, lf, o0, defs), SPEC(len, t, defs, os, ow, o0, oa, s, LI.BE(len, t, s, lf)), WT.TX(len, t, TE(len, t, s, lf))):
  match c:
    case True{}:
      %at_s(len, t, Bool.pick(U32, U32.is_lt(s, lf), (lf - 1 : U32), lf)) :
        SPR(len, t, NS.go.cr(_, s, lf, o0, defs), SPEC(len, t, defs, os, ow, o0, oa, s, LI.BE(len, t, s, lf)), WT.TX(len, t, TE(len, t, s, lf)))
      body_t(len, t, d, hl, bw, defs, os, ow, o0, oa, s, lf, hsl, hlf)
    case False{}:
      none(len, t, SPEC(len, t, defs, os, ow, o0, oa, s, LI.BE(len, t, s, lf)), WT.TX(len, t, TE(len, t, s, lf)))

def split_body(+len: U32, +t: AT.Tree<U32>, +d: Nat, +hl: {D.ok(C.BT(len, t), d) == True{} : Bool}, +bw: BW, +defs: B.Defs, +os: Bool, +ow: Nat, +o0: Bool, +oa: Ss(),
  +s: U32, +lf: U32, +hsl: {Nat.is_le(n(s), n(lf)) == True{} : Bool}, +hlf: {Nat.is_lt(n(lf), n(len)) == True{} : Bool}) ->
  SPR(len, t, NS.split(C.BT(len, t), s, lf, o0, defs), SPEC(len, t, defs, os, ow, o0, oa, s, LI.BE(len, t, s, lf)), WT.TX(len, t, TE(len, t, s, lf))):
  sz.k(len, t, d, hl, bw, defs, os, ow, o0, oa, s, lf, hsl, hlf, U32.is_le(s, lf) && U32.is_le((lf - s : U32), 268435456))

# ---------------------------------------------------------------------------
# The byte splitter is B.Rec.parts
# ---------------------------------------------------------------------------

# The line before the LF at lf.
def LP(+len: U32, +t: AT.Tree<U32>, +s: U32, +lf: U32) -> B.Line:
  B.Text.line(LI.TXR(len, t, s, lf))

# The line s .. lf (its LF at lf, in the buffer) split by NS.split: either
# it comes back alone (the String path decides), or it comes back with a
# buffer of records, and then B.Rec.parts (with -m, the header's
# definitions defs) splits the line's body into pieces ps, and the buffer
# holds each piece followed by the line's terminator (norm_seq's recs_text).
law split_t:
  for +len: U32
  for +t: AT.Tree<U32>
  for +d: Nat
  for +hl: {D.ok(C.BT(len, t), d) == True{} : Bool}
  for +bd: Nat
  for +hbd: {Nat.pow(2n, 32n) == bd : Nat}
  for +defs: B.Defs
  for +os: Bool
  for +ow: Nat
  for +o0: Bool
  for +oa: Ss()
  for +s: U32
  for +lf: U32
  for +hsl: {Nat.is_le(n(s), n(lf)) == True{} : Bool}
  for +hlf: {Nat.is_lt(n(lf), n(len)) == True{} : Bool}
  for +h10: {C.AT(len, t, lf) == 10 : U32}
  SPR(len, t, NS.split(C.BT(len, t), s, lf, o0, defs), B.Rec.parts(defs, B.Opts{os, ow, True{}, o0, oa}, B.Line.body(LP(len, t, s, lf))), B.Line.term(LP(len, t, s, lf)))

def split_t(len, t, d, hl, bd, hbd, defs, os, ow, o0, oa, s, lf, hsl, hlf, h10):
  %Equal.sym(B.Line, LP(len, t, s, lf), LI.LINE(len, t, s, lf, LI.BE(len, t, s, lf)), LI.line_t(len, t, d, hl, s, lf, hsl, hlf, h10)) :
    SPR(len, t, NS.split(C.BT(len, t), s, lf, o0, defs), B.Rec.parts(defs, B.Opts{os, ow, True{}, o0, oa}, B.Line.body(_)), B.Line.term(_))
  split_body(len, t, d, hl, bw(bd, hbd), defs, os, ow, o0, oa, s, lf, hsl, hlf)
