def ref.n9(+len: U32, +t: AT.Tree<U32>, +d: Nat, +hl: {D.ok(C.BT(len, t), d) == True{} : Bool}, +bd: Nat, +hbd: {Nat.pow(2n, 32n) == bd : Nat},
