# The byte splitter's driver (norm_split.bend's go.*, split): a line it
# splits is one B.Rec.parts splits (Pieces), and the records' buffer holds
# their text, each followed by the line's terminator; a line it does not
# split comes back untouched (the String path decides). Every variable is
# reusable. Generated by data/tmp/split/tools/gendrv.py.

def n(+x: U32) -> Nat:
  U32.to_nat(x)

def Ss() -> Data:
  List<&2, String>

def Rgs() -> Data:
  List<&2, NS.Rg>

# The bound 2^32 (proof_s_gt's bd, hbd), wrapped so that no definition but
# recs has Nat.pow(2n, 32n) in its context.
type BW is Data:
  BW{bd: Nat, h: {Nat.pow(2n, 32n) == bd : Nat}}

def bw(+bd: Nat, +h: {Nat.pow(2n, 32n) == bd : Nat}) -> BW:
  BW{bd, h}

# What B.Rec.parts says of the body s .. be-1, with -m.
def SPEC(+len: U32, +t: AT.Tree<U32>, +defs: B.Defs, +os: Bool, +ow: Nat, +o0: Bool, +oa: Ss(), +s: U32, +be: U32) -> B.Parts:
  B.Rec.parts(defs, B.Opts{os, ow, True{}, o0, oa}, LI.TXR(len, t, s, be))

# The terminator is CR LF (norm_split.bend's is_crlf, on the range alone).
def CRT(+term: NS.Rg) -> Bool:
  match term:
    case NS.Rg{+a, +z}:
      U32.is_eq((z - a : U32), 2)

def crt_eq(+fs: Rgs(), +iks: List<&2, NS.Ik>, +fks: List<&2, NS.Fk>, +term: NS.Rg) -> {NS.is_crlf(NS.Ln{fs, iks, fks, term}) == CRT(term) : Bool}:
  match term:
    case NS.Rg{+a, +z}:
      {==}

# A line the splitter does not split: it comes back alone (False: the
# String path decides), or refused (True) with the code c that B.Rec.parts
# refuses its body bdy with, and the ranges of its CHROM and POS.
def SPN(+r: Bool, +len: U32, +t: AT.Tree<U32>, -out: NS.Ans, +pt: B.Parts, +bdy: String) -> Type:
  match r:
    case False{}:
      {out == NS.Out{C.BT(len, t), None{}} : NS.Ans}
    case True{}:
      &c: B.Code -> &f0: NS.Rg -> &f1: NS.Rg -> ({out == NS.Ref{C.BT(len, t), c, f0, f1} : NS.Ans} & ({pt == B.Unsplit{c} : B.Parts} &
        ({NS.txt(C.BT(len, t), f0) == (C.BT(len, t), B.Rec.field(B.Rec.fields(bdy), 0n)) : D.Bytes & String} &
          {NS.txt(C.BT(len, t), f1) == (C.BT(len, t), B.Rec.field(B.Rec.fields(bdy), 1n)) : D.Bytes & String})))

def SPF(+len: U32, +t: AT.Tree<U32>, -out: NS.Ans, +pt: B.Parts, +bdy: String) -> Type:
  &r: Bool -> SPN(r, len, t, out, pt, bdy)

# The splitter's answer: the line back with records (True: the line is
# split into pieces ps, the records' buffer holds their text, each followed
# by the terminator, and passed the check: one LF per piece, and no CR
# unless the terminator is CR LF, cr), or the line back alone (False).
def SPB(+b: Bool, +len: U32, +t: AT.Tree<U32>, -out: NS.Ans, +pt: B.Parts, +bdy: String, +term: String, +cr: Bool) -> Type:
  match b:
    case True{}:
      &l2: U32 -> &t2: AT.Tree<U32> -> &ps: Ss() -> ({out == NS.Out{C.BT(len, t), Some{C.BT(l2, t2)}} : NS.Ans} &
        ({W.OK(l2, t2) == True{} : Bool} & ({pt == B.Pieces{ps} : B.Parts} & ({NR.chars(W.V(l2, t2)) == Norm.recs_text(ps, term) : String} &
          CK.CK(l2, t2, List.length(&2, String, ps), cr)))))
    case False{}:
      SPF(len, t, out, pt, bdy)

def SPR(+len: U32, +t: AT.Tree<U32>, -out: NS.Ans, +pt: B.Parts, +bdy: String, +term: String, +cr: Bool) -> Type:
  &b: Bool -> SPB(b, len, t, out, pt, bdy, term, cr)

def none(+len: U32, +t: AT.Tree<U32>, +pt: B.Parts, +bdy: String, +term: String, +cr: Bool) -> SPR(len, t, NS.Out{C.BT(len, t), None{}}, pt, bdy, term, cr):
  (False{}, (False{}, {==}))

# ---------------------------------------------------------------------------
# The mirrors, turned for rewriting
# ---------------------------------------------------------------------------

def cut_s(+len: U32, +t: AT.Tree<U32>, +d: Nat, +hl: {D.ok(C.BT(len, t), d) == True{} : Bool}, +a: U32, +z: U32, +c: U32,
  +haz: {U32.is_le(a, z) == True{} : Bool}, +hz: {Nat.is_le(n(z), n(len)) == True{} : Bool}, +hc: {U32.is_lt(c, 256) == True{} : Bool}) ->
  {(C.BT(len, t), K.CUT(len, t, a, z, c)) == NS.cut(C.BT(len, t), NS.Rg{a, z}, c) : D.Bytes & Rgs()}:
  Equal.sym(D.Bytes & Rgs(), NS.cut(C.BT(len, t), NS.Rg{a, z}, c), (C.BT(len, t), K.CUT(len, t, a, z, c)), K.cut_t(len, t, d, a, z, c, hl, haz, hz, hc))

def iks_s(+xs: Rgs(), +len: U32, +t: AT.Tree<U32>, +d: Nat, +tags: List<&2, B.Tag>, +hl: {D.ok(C.BT(len, t), d) == True{} : Bool}, +hps: {K.ALLPV(len, xs) == True{} : Bool}) ->
  {(C.BT(len, t), KD.MAPI(len, t, tags, xs)) == NS.ikinds(xs, C.BT(len, t), tags) : D.Bytes & List<&2, NS.Ik>}:
  Equal.sym(D.Bytes & List<&2, NS.Ik>, NS.ikinds(xs, C.BT(len, t), tags), (C.BT(len, t), KD.MAPI(len, t, tags, xs)), KD.ikinds_t(xs, len, t, d, tags, hl, hps))

def fks_s(+xs: Rgs(), +len: U32, +t: AT.Tree<U32>, +d: Nat, +tags: List<&2, B.Tag>, +hl: {D.ok(C.BT(len, t), d) == True{} : Bool}, +hps: {K.ALLPV(len, xs) == True{} : Bool}) ->
  {(C.BT(len, t), KD.MAPF(tags, K.TXS(len, t, xs))) == NS.fkinds(xs, C.BT(len, t), tags) : D.Bytes & List<&2, NS.Fk>}:
  Equal.sym(D.Bytes & List<&2, NS.Fk>, NS.fkinds(xs, C.BT(len, t), tags), (C.BT(len, t), KD.MAPF(tags, K.TXS(len, t, xs))), KD.fkinds_t(xs, len, t, d, tags, hl, hps))

def dst_s(+xs: Rgs(), +ok: Bool, +len: U32, +t: AT.Tree<U32>, +d: Nat, +hl: {D.ok(C.BT(len, t), d) == True{} : Bool}, +hps: {K.ALLPV(len, xs) == True{} : Bool}) ->
  {(C.BT(len, t), Bool.and(ok, B.Alts.distinct(K.TXS(len, t, xs)))) == NS.distinct(xs, (C.BT(len, t), ok)) : D.Bytes & Bool}:
  Equal.sym(D.Bytes & Bool, NS.distinct(xs, (C.BT(len, t), ok)), (C.BT(len, t), Bool.and(ok, B.Alts.distinct(K.TXS(len, t, xs)))), DP.distinct_t(xs, ok, len, t, d, hl, hps))

def lt_s(+len: U32, +t: AT.Tree<U32>, +d: Nat, +x: NS.Rg, +hl: {D.ok(C.BT(len, t), d) == True{} : Bool}, +hp: {W.PV(len, x) == True{} : Bool}) ->
  {(C.BT(len, t), B.Text.is_letters(WT.TX(len, t, x))) == NS.letters(C.BT(len, t), x) : D.Bytes & Bool}:
  Equal.sym(D.Bytes & Bool, NS.letters(C.BT(len, t), x), (C.BT(len, t), B.Text.is_letters(WT.TX(len, t, x))), RD.letters_t(len, t, d, x, hl, hp))

def dg_s(+len: U32, +t: AT.Tree<U32>, +a: U32, +z: U32) ->
  {(C.BT(len, t), Pair.snd(D.Bytes, Bool, FC.digits(C.BT(len, t), a, z))) == FC.digits(C.BT(len, t), a, z) : D.Bytes & Bool}:
  Equal.sym(D.Bytes & Bool, FC.digits(C.BT(len, t), a, z), (C.BT(len, t), Pair.snd(D.Bytes, Bool, FC.digits(C.BT(len, t), a, z))), FL.digits_pair(C.BT(len, t), a, z))

def at_s(+len: U32, +t: AT.Tree<U32>, +i: U32) -> {(C.BT(len, t), C.AT(len, t, i)) == BY.at(C.BT(len, t), i) : D.Bytes & U32}:
  Equal.sym(D.Bytes & U32, BY.at(C.BT(len, t), i), (C.BT(len, t), C.AT(len, t, i)), C.at_pair_t(len, t, i))

# POS digits: B.Pos.read reads a number.
def pos_ok(+len: U32, +t: AT.Tree<U32>, +d: Nat, +hl: {D.ok(C.BT(len, t), d) == True{} : Bool}, +a: U32, +z: U32,
  +haz: {U32.is_le(a, z) == True{} : Bool}, +hz: {Nat.is_le(n(z), n(len)) == True{} : Bool},
  +e: {Pair.snd(D.Bytes, Bool, FC.digits(C.BT(len, t), a, z)) == True{} : Bool}) ->
  {Maybe.is_none(&2, Nat, B.Pos.read(WT.TX(len, t, NS.Rg{a, z}))) == False{} : Bool}:
  +X = D.slice(RD.X(len, t), n(a), Nat.sub(n(z), n(a)))
  +hn = Equal.trans(Bool, Nat.is_le(n(a), n(z)), U32.is_le(a, z), True{}, Equal.sym(Bool, U32.is_le(a, z), Nat.is_le(n(a), n(z)), U.is_le_to_nat(a, z)), haz)
  +hsm = Equal.trans(Bool, Maybe.is_some(&2, Nat, FD.dec(X)), Pair.snd(D.Bytes, Bool, FC.digits(C.BT(len, t), a, z)), True{},
    Equal.sym(Bool, Pair.snd(D.Bytes, Bool, FC.digits(C.BT(len, t), a, z)), FD.all_digits(X), FL.digits_view(C.BT(len, t), d, a, z, hl, haz, hz)), e)
  %Equal.sym(String, WT.TX(len, t, NS.Rg{a, z}), NR.chars(X), RD.tx_eq(len, t, a, z, hn)) : {Maybe.is_none(&2, Nat, B.Pos.read(_)) == False{} : Bool}
  %Equal.sym(Maybe<&2, Nat>, B.Pos.read(NR.chars(X)), FD.dec(X), TK.read_dec(X)) : {Maybe.is_none(&2, Nat, _) == False{} : Bool}
  %Equal.sym(Bool, Maybe.is_some(&2, Nat, FD.dec(X)), True{}, hsm) : {Bool.not(_) == False{} : Bool}
  {==}

# ---------------------------------------------------------------------------
# The writes: records, then the last flush
# ---------------------------------------------------------------------------

def recs(+len: U32, +t: AT.Tree<U32>, +d: Nat, +hl: {D.ok(C.BT(len, t), d) == True{} : Bool}, +bd: Nat, +hbd: {Nat.pow(2n, 32n) == bd : Nat},
  +defs: B.Defs, +k1: Ss(), +o0: Bool, +s: U32, +hs: {W.PV(len, NS.Rg{s, s}) == True{} : Bool}, +be: U32, +hbl: {Nat.is_lt(n(be), n(len)) == True{} : Bool},
  +term: NS.Rg, +hpt: {W.PV(len, term) == True{} : Bool}, +f0: NS.Rg, +f1: NS.Rg, +f2: NS.Rg, +f3: NS.Rg, +f4: NS.Rg, +f5: NS.Rg, +f6: NS.Rg, +a7: U32, +z7: U32, +rest: Rgs(), +alts: Rgs(), +hps: {K.ALLPV(be, RC.FSX(f0, f1, f2, f3, f4, f5, f6, a7, z7, rest)) == True{} : Bool}, +hpas: {K.ALLPV(len, alts) == True{} : Bool}) ->
  TOP.WRES(len, t, NS.go.write(s, NS.Ln{RC.FSX(f0, f1, f2, f3, f4, f5, f6, a7, z7, rest), KD.MAPI(len, t, RC.DI(defs), K.CUT(len, t, a7, z7, 59)), KD.MAPF(RC.DF(defs), k1), term}, C.BT(len, t), alts, o0), RC.RT(len, t, defs, RC.FSX(f0, f1, f2, f3, f4, f5, f6, a7, z7, rest), k1, o0, List.length(&2, NS.Rg, alts), term, alts, 1n), RC.RG(len, t, defs, RC.FSX(f0, f1, f2, f3, f4, f5, f6, a7, z7, rest), k1, o0, List.length(&2, NS.Rg, alts), alts, 1n), List.length(&2, NS.Rg, alts), CRT(term)):
  +pv7 = LI.pv_at(be, RC.FSX(f0, f1, f2, f3, f4, f5, f6, a7, z7, rest), 7n, hps)
  %crt_eq(RC.FSX(f0, f1, f2, f3, f4, f5, f6, a7, z7, rest), KD.MAPI(len, t, RC.DI(defs), K.CUT(len, t, a7, z7, 59)), KD.MAPF(RC.DF(defs), k1), term) :
    TOP.WRES(len, t, NS.go.write(s, NS.Ln{RC.FSX(f0, f1, f2, f3, f4, f5, f6, a7, z7, rest), KD.MAPI(len, t, RC.DI(defs), K.CUT(len, t, a7, z7, 59)), KD.MAPF(RC.DF(defs), k1), term}, C.BT(len, t), alts, o0), RC.RT(len, t, defs, RC.FSX(f0, f1, f2, f3, f4, f5, f6, a7, z7, rest), k1, o0, List.length(&2, NS.Rg, alts), term, alts, 1n), RC.RG(len, t, defs, RC.FSX(f0, f1, f2, f3, f4, f5, f6, a7, z7, rest), k1, o0, List.length(&2, NS.Rg, alts), alts, 1n), List.length(&2, NS.Rg, alts), _)
  TOP.write_t(len, t, d, hl, s, NS.records(alts, NS.Sw{C.BT(len, t), BY.empty(0n), NS.Rg{s, s}, True{}}, NS.Ln{RC.FSX(f0, f1, f2, f3, f4, f5, f6, a7, z7, rest), KD.MAPI(len, t, RC.DI(defs), K.CUT(len, t, a7, z7, 59)), KD.MAPF(RC.DF(defs), k1), term}, o0, List.length(&2, NS.Rg, alts), 1n), RC.RT(len, t, defs, RC.FSX(f0, f1, f2, f3, f4, f5, f6, a7, z7, rest), k1, o0, List.length(&2, NS.Rg, alts), term, alts, 1n), RC.RG(len, t, defs, RC.FSX(f0, f1, f2, f3, f4, f5, f6, a7, z7, rest), k1, o0, List.length(&2, NS.Rg, alts), alts, 1n), List.length(&2, NS.Rg, alts), NS.is_crlf(NS.Ln{RC.FSX(f0, f1, f2, f3, f4, f5, f6, a7, z7, rest), KD.MAPI(len, t, RC.DI(defs), K.CUT(len, t, a7, z7, 59)), KD.MAPF(RC.DF(defs), k1), term}),
    RC.records_t(alts, 1n, len, t, d, hl, defs, k1, o0, List.length(&2, NS.Rg, alts), f0, f1, f2, f3, f4, f5, f6, a7, z7, rest, term, be, hps, hbl, hpas, hpt,
      LI.ule(be, a7, z7, pv7), RC.pv_lt(len, be, a7, z7, pv7, hbl), bd, hbd, NS.Sw{C.BT(len, t), BY.empty(0n), NS.Rg{s, s}, True{}}, TOP.W0(s), TOP.rel0(len, t, s, hs)))

# The pieces: one per ALT.
def psl_len(+len: U32, +t: AT.Tree<U32>, +defs: B.Defs, +fs: Rgs(), +kss: Ss(), +o: Bool, +nalt: Nat, alts: Rgs(), +i: Nat) ->
  {List.length(&2, String, RC.PSL(len, t, defs, fs, kss, o, nalt, alts, i)) == List.length(&2, NS.Rg, alts) : Nat}:
  match alts:
    case Nil{}:
      {==}
    case Con{+a, r}:
      Equal.cong(Nat, Nat, x => 1n+x, List.length(&2, String, RC.PSL(len, t, defs, fs, kss, o, nalt, r, 1n+i)), List.length(&2, NS.Rg, r), psl_len(len, t, defs, fs, kss, o, nalt, r, 1n+i))

def ck.k(+l2: U32, +t2: AT.Tree<U32>, +k1: Nat, +k2: Nat, +cr: Bool, +e: {k1 == k2 : Nat}, c: CK.CK(l2, t2, k1, cr)) -> CK.CK(l2, t2, k2, cr):
  (h10, hcr) = c
  (Equal.trans(Nat, FD.count(W.V(l2, t2), 10), k1, k2, h10, e), hcr)

# ---------------------------------------------------------------------------
# A line the writer gives up on: refused, or back alone
# ---------------------------------------------------------------------------

# FORMAT's keys k1 (what the writer's kinds are of) are those of field 8,
# when there is one.
def RK(+len: U32, +t: AT.Tree<U32>, +rest: Rgs(), +k1: Ss()) -> Type:
  match rest:
    case Nil{}:
      {True{} == True{} : Bool}
    case Con{+f8, +cols}:
      {k1 == String.split(WT.TX(len, t, f8), ':') : Ss()}

def sm2(x: Maybe<&2, Maybe<&2, B.Code>>) -> Bool:
  match x:
    case Some{Some{c}}:
      True{}
    case _:
      False{}

def un2(+d: B.Code, x: Maybe<&2, Maybe<&2, B.Code>>) -> B.Code:
  match x:
    case Some{Some{+c}}:
      c
    case _:
      d

def MMC() -> Data:
  Maybe<&2, Maybe<&2, B.Code>>

# A refusal c: the parts are Unsplit{c}.
def unsplit_of(+pt: B.Parts, +c: B.Code, +h: {L.refusal(pt) == Some{Some{c}} : MMC()}) -> {pt == B.Unsplit{c} : B.Parts}:
  match pt:
    case B.Whole{}:
      Empty.absurd({B.Whole{} == B.Unsplit{c} : B.Parts}, N.false_ne_true(Equal.cong(MMC(), Bool, x => sm2(x), None{}, Some{Some{c}}, h)))
    case B.Pieces{+ps}:
      Empty.absurd({B.Pieces{ps} == B.Unsplit{c} : B.Parts}, N.false_ne_true(Equal.cong(MMC(), Bool, x => sm2(x), Some{None{}}, Some{Some{c}}, h)))
    case B.Unsplit{+c2}:
      Equal.cong(B.Code, B.Parts, x => B.Unsplit{x}, c2, c, Equal.cong(MMC(), B.Code, x => un2(c2, x), Some{Some{c2}}, Some{Some{c}}, h))

def spf.m(+m: Maybe<&2, B.Code>, +len: U32, +t: AT.Tree<U32>, +pt: B.Parts, +bdy: String, +f0: NS.Rg, +f1: NS.Rg,
  +hr: {L.refusal(pt) == Some{m} : MMC()},
  +h0: {NS.txt(C.BT(len, t), f0) == (C.BT(len, t), B.Rec.field(B.Rec.fields(bdy), 0n)) : D.Bytes & String},
  +h1: {NS.txt(C.BT(len, t), f1) == (C.BT(len, t), B.Rec.field(B.Rec.fields(bdy), 1n)) : D.Bytes & String}) ->
  SPF(len, t, RF.RF(len, t, m, f0, f1), pt, bdy):
  match m:
    case None{}:
      (False{}, {==})
    case Some{+c}:
      (True{}, (c, (f0, (f1, ({==}, (unsplit_of(pt, c, hr), (h0, h1)))))))

def pv_upr(+len: U32, +bb: U32, +x: NS.Rg, +hp: {W.PV(bb, x) == True{} : Bool}, +hb: {Nat.is_lt(n(bb), n(len)) == True{} : Bool}) -> {W.PV(len, x) == True{} : Bool}:
  match x:
    case NS.Rg{+a, +z}:
      RC.pv_up(len, bb, a, z, hp, hb)

# A field's text, as the record's fields say.
def fld(+len: U32, +t: AT.Tree<U32>, +d: Nat, +hl: {D.ok(C.BT(len, t), d) == True{} : Bool}, +bdy: String, +fs: Rgs(), +x: NS.Rg, +k: Nat,
  +hf: {B.Rec.fields(bdy) == K.TXS(len, t, fs) : Ss()}, +hp: {W.PV(len, x) == True{} : Bool},
  +hx: {B.Rec.field(K.TXS(len, t, fs), k) == WT.TX(len, t, x) : String}) ->
  {NS.txt(C.BT(len, t), x) == (C.BT(len, t), B.Rec.field(B.Rec.fields(bdy), k)) : D.Bytes & String}:
  %Equal.sym(Ss(), B.Rec.fields(bdy), K.TXS(len, t, fs), hf) : {NS.txt(C.BT(len, t), x) == (C.BT(len, t), B.Rec.field(_, k)) : D.Bytes & String}
  %Equal.sym(String, B.Rec.field(K.TXS(len, t, fs), k), WT.TX(len, t, x), hx) : {NS.txt(C.BT(len, t), x) == (C.BT(len, t), _) : D.Bytes & String}
  RD.txt_t(len, t, d, x, hl, hp)

# The parts refuse with the line's first problem after its ALTs.
def ref_r(+len: U32, +t: AT.Tree<U32>, +defs: B.Defs, +o0: Bool, +fs: Rgs(), +alts: Rgs(), +pt: B.Parts,
  +hpe: {pt == LI.PT(len, t, defs, o0, fs, alts) : B.Parts},
  +h2: {Nat.is_le(2n, List.length(&2, NS.Rg, alts)) == True{} : Bool},
  +hl8: {Nat.is_lt(List.length(&2, String, K.TXS(len, t, fs)), 8n) == False{} : Bool}) ->
  {L.refusal(pt) == Some{WH.PROBF(K.TXS(len, t, fs), defs, List.length(&2, NS.Rg, alts))} : MMC()}:
  +TA = K.TXS(len, t, alts)
  +TF = K.TXS(len, t, fs)
  +nn = List.length(&2, NS.Rg, alts)
  +el = LI.txs_len(len, t, alts)
  +h2s = {%Equal.sym(Nat, List.length(&2, String, TA), nn, el) : {Nat.is_le(2n, _) == True{} : Bool}; h2 : {Nat.is_le(2n, List.length(&2, String, TA)) == True{} : Bool}}
  %Equal.sym(B.Parts, pt, LI.PT(len, t, defs, o0, fs, alts), hpe) : {L.refusal(_) == Some{WH.PROBF(TF, defs, nn)} : MMC()}
  %Equal.sym(Nat, nn, List.length(&2, String, TA), Equal.sym(Nat, List.length(&2, String, TA), nn, el)) :
    {L.refusal(B.Parts.of(B.Rec.pieces.go(TA, TF, defs, o0, _, 1n))) == Some{WH.PROBF(TF, defs, _)} : MMC()}
  WH.ws.p(TA, TF, defs, o0, h2s, hl8)

def lt0(+x: Nat) -> {Nat.is_lt(x, 0n) == False{} : Bool}:
  match x:
    case 0n:
      {==}
    case 1n+k:
      {==}

def len8(+len: U32, +t: AT.Tree<U32>, +f0: NS.Rg, +f1: NS.Rg, +f2: NS.Rg, +f3: NS.Rg, +f4: NS.Rg, +f5: NS.Rg, +f6: NS.Rg, +a7: U32, +z7: U32, +rest: Rgs()) ->
  {Nat.is_lt(List.length(&2, String, K.TXS(len, t, RC.FSX(f0, f1, f2, f3, f4, f5, f6, a7, z7, rest))), 8n) == False{} : Bool}:
  lt0(List.length(&2, String, K.TXS(len, t, rest)))

def apd(+bb: U32, +x: NS.Rg, +r: Rgs(), +h: {K.ALLPV(bb, Con{x, r}) == True{} : Bool}) -> {K.ALLPV(bb, r) == True{} : Bool}:
  N.and_true_r(W.PV(bb, x), K.ALLPV(bb, r), h)

def drop8(+bb: U32, +f0: NS.Rg, +f1: NS.Rg, +f2: NS.Rg, +f3: NS.Rg, +f4: NS.Rg, +f5: NS.Rg, +f6: NS.Rg, +a7: U32, +z7: U32, +r: Rgs(),
  +h: {K.ALLPV(bb, RC.FSX(f0, f1, f2, f3, f4, f5, f6, a7, z7, r)) == True{} : Bool}) -> {K.ALLPV(bb, r) == True{} : Bool}:
  apd(bb, NS.Rg{a7, z7}, r, apd(bb, f6, Con{NS.Rg{a7, z7}, r}, apd(bb, f5, Con{f6, Con{NS.Rg{a7, z7}, r}}, apd(bb, f4, Con{f5, Con{f6, Con{NS.Rg{a7, z7}, r}}},
    apd(bb, f3, Con{f4, Con{f5, Con{f6, Con{NS.Rg{a7, z7}, r}}}}, apd(bb, f2, Con{f3, Con{f4, Con{f5, Con{f6, Con{NS.Rg{a7, z7}, r}}}}},
      apd(bb, f1, Con{f2, Con{f3, Con{f4, Con{f5, Con{f6, Con{NS.Rg{a7, z7}, r}}}}}}, apd(bb, f0, Con{f1, Con{f2, Con{f3, Con{f4, Con{f5, Con{f6, Con{NS.Rg{a7, z7}, r}}}}}}}, h))))))))


