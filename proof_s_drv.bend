      be_hi.c(s, lf, Equal.trans(Bool, Nat.is_lt(n(s), n(lf)), U32.is_lt(s, lf), True{}, Equal.sym(Bool, U32.is_lt(s, lf), Nat.is_lt(n(s), n(lf)), U.is_lt_to_nat(s, lf)), e),
        U32.is_eq(C.AT(len, t, LI.U1(lf)), 13))
    case False{}:
      N.le_refl(n(lf))

def CR(+len: U32, +t: AT.Tree<U32>, +s: U32, +lf: U32) -> Bool:
  U32.is_lt(s, lf) && U32.is_eq(LI.XC(len, t, U32.is_lt(s, lf), lf), 13)

def TE(+len: U32, +t: AT.Tree<U32>, +s: U32, +lf: U32) -> NS.Rg:
  NS.Rg{LI.BE(len, t, s, lf), (lf + 1 : U32)}

# The body (s .. BE-1) cut at tabs, then the driver.
# A count of 0 of byte 13 in bytes: their text holds no CR.
law cnt0_cr.c:
  for +b: Bool
  for +x: U32
  for +xs: List<&2, U32>
  for +eb: {U32.is_eq(x, 13) == b : Bool}
  for +h: {FD.count.if(b, FD.count(xs, 13)) == 0n : Nat}
  for k: {FD.count(xs, 13) == 0n : Nat} -> {B.Text.has_cr(NR.chars(xs)) == False{} : Bool}
  {B.Text.has_cr(NR.chars(Con{x, xs})) == False{} : Bool}

def cnt0_cr.c(b, x, xs, eb, h, k):
  match b:
    case True{}:
      Empty.absurd({B.Text.has_cr(NR.chars(Con{x, xs})) == False{} : Bool}, N.succ_ne_zero(FD.count(xs, 13), h))
    case False{}:
      %Equal.sym(Bool, U32.is_eq(x, 13), False{}, eb) : {Bool.or(_, B.Text.has_cr(NR.chars(xs))) == False{} : Bool}
      k(h)

law cnt0_cr:
  for +xs: List<&2, U32>
  for +h: {FD.count(xs, 13) == 0n : Nat}
  {B.Text.has_cr(NR.chars(xs)) == False{} : Bool}

def cnt0_cr(xs, h):
  match xs:
    case Nil{}:
      {==}
    case Con{+x, +t}:
      cnt0_cr.c(U32.is_eq(x, 13), x, t, {==}, h, h2 => cnt0_cr(t, h2))

# The line's body holds no CR: the splitter cuts it into fields.
def body_z(+len: U32, +t: AT.Tree<U32>, +d: Nat, +hl: {D.ok(C.BT(len, t), d) == True{} : Bool}, +bw: BW, +defs: B.Defs, +os: Bool, +ow: Nat, +o0: Bool, +oa: Ss(),
  +s: U32, +lf: U32, +hsl: {Nat.is_le(n(s), n(lf)) == True{} : Bool}, +hlf: {Nat.is_lt(n(lf), n(len)) == True{} : Bool},
  +hcr: {B.Text.has_cr(LI.TXR(len, t, s, LI.BE(len, t, s, lf))) == False{} : Bool}) ->
  SPR(len, t, NS.go.fields(NS.cut(C.BT(len, t), NS.Rg{s, LI.BE(len, t, s, lf)}, 9), s, o0, TE(len, t, s, lf), defs), SPEC(len, t, defs, os, ow, o0, oa, s, LI.BE(len, t, s, lf)), LI.TXR(len, t, s, LI.BE(len, t, s, lf)), WT.TX(len, t, TE(len, t, s, lf)), CRT(TE(len, t, s, lf))):
  +be = LI.BE(len, t, s, lf)
  +lo = be_lo.k(len, t, s, lf, hsl, U32.is_lt(s, lf), {==})
  +hi = be_hi.k(len, t, s, lf, U32.is_lt(s, lf), {==})
  +hbl = N.le_lt_trans(n(be), n(lf), n(len), hi, hlf)
  +hsle = Equal.trans(Bool, U32.is_le(s, be), Nat.is_le(n(s), n(be)), True{}, U.is_le_to_nat(s, be), lo)
  +hs = W.pv_mk(len, s, s, N.le_refl(n(s)), N.le_trans(n(s), n(lf), n(len), hsl, N.lt_to_le(n(lf), n(len), hlf)))
  +e1 = W.inc_n(len, t, d, lf, hl, LI.ult(lf, len, hlf))
  +hl1 = {%Equal.sym(Nat, n((lf + 1 : U32)), Nat.add(n(lf), 1n), e1) : {Nat.is_le(_, n(len)) == True{} : Bool};
    %Equal.sym(Nat, Nat.add(n(lf), 1n), 1n+n(lf), N.add_one(n(lf))) : {Nat.is_le(_, n(len)) == True{} : Bool};
    Equal.trans(Bool, Nat.is_le(1n+n(lf), n(len)), Nat.is_lt(n(lf), n(len)), True{}, N.le_succ_lt(n(lf), n(len)), hlf) : {Nat.is_le(n((lf + 1 : U32)), n(len)) == True{} : Bool}}
  +hl2 = {%Equal.sym(Nat, n((lf + 1 : U32)), Nat.add(n(lf), 1n), e1) : {Nat.is_le(n(lf), _) == True{} : Bool};
    N.le_add_r(n(lf), 1n) : {Nat.is_le(n(lf), n((lf + 1 : U32))) == True{} : Bool}}
  +hpt = W.pv_mk(len, be, (lf + 1 : U32), N.le_trans(n(be), n(lf), n((lf + 1 : U32)), hi, hl2), hl1)
  +FS = K.CUT(len, t, s, be, 9)
  %cut_s(len, t, d, hl, s, be, 9, hsle, N.lt_to_le(n(be), n(len), hbl), {==}) :
    SPR(len, t, NS.go.fields(_, s, o0, TE(len, t, s, lf), defs), SPEC(len, t, defs, os, ow, o0, oa, s, be), LI.TXR(len, t, s, be), WT.TX(len, t, TE(len, t, s, lf)), CRT(TE(len, t, s, lf)))
  gf(len, t, d, hl, bw, defs, os, ow, o0, oa, s, hs, be, hbl, hcr, TE(len, t, s, lf), hpt, FS, K.cut_pvz(len, t, d, s, be, 9, hl, hsle, hbl, {==}),
    Equal.sym(Ss(), K.TXS(len, t, FS), String.split(WT.TX(len, t, NS.Rg{s, be}), Chr{9}), K.cut_tx(len, t, d, s, be, 9, hl, hsle, hbl, {==})))


def body_k(k2: Nat, +len: U32, +t: AT.Tree<U32>, +d: Nat, +hl: {D.ok(C.BT(len, t), d) == True{} : Bool}, +bw: BW, +defs: B.Defs, +os: Bool, +ow: Nat, +o0: Bool, +oa: Ss(),
  +s: U32, +lf: U32, +hsl: {Nat.is_le(n(s), n(lf)) == True{} : Bool}, +hlf: {Nat.is_lt(n(lf), n(len)) == True{} : Bool},
  +ek: {k2 == FD.count(SC.BS(len, t, s, LI.BE(len, t, s, lf)), 13) : Nat}) ->
